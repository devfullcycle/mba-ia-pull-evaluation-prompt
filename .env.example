# LangSmith Configuration
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=

# Nome do projeto de tracing no LangSmith.
# Não deixe em branco: além do tracing, este valor é usado para montar o nome do
# dataset de avaliação ({LANGSMITH_PROJECT}-eval).
LANGSMITH_PROJECT=mba-ia-pull-evaluation-prompt

# Seu handle público do LangSmith Hub (o "username" que vai no nome do prompt).
# Ele é criado no momento em que você torna um prompt público:
#   1. Abra o prompt em LangSmith > Prompts
#   2. Clique nos três pontinhos no canto superior direito, ao lado do botão Playground
#   3. Escolha "Make Public"
#   4. Na tela "Choose your public handle", defina o seu handle
# Atenção: o handle é definitivo depois de confirmado, então escolha com calma.
USERNAME_LANGSMITH_HUB=

# OpenAI Configuration
OPENAI_API_KEY=

# Google Gemini Configuration
GOOGLE_API_KEY=

# LLM Configuration
# Provider a ser usado: "google" ou "openai"
LLM_PROVIDER=google

# Modelos: este desafio NÃO fixa versões de modelo, porque elas mudam e são
# descontinuadas com frequência. Consulte a documentação oficial do provider que
# você escolheu, veja quais modelos estão disponíveis hoje e preencha abaixo:
#   Google  -> https://ai.google.dev/gemini-api/docs/models
#   OpenAI  -> https://platform.openai.com/docs/models
#
#   LLM_MODEL  = modelo que gera a resposta
#   EVAL_MODEL = modelo que avalia as respostas (pode ser o mesmo, ou um mais capaz)
#
# Escolha modelos que aceitem temperature=0, para que a avaliação seja
# reproduzível. Alguns modelos de raciocínio aceitam apenas o valor padrão e
# retornam erro 400 se a temperatura for definida.
LLM_MODEL=
EVAL_MODEL=
